[Unit]
Description=TitanShare Daemon — Android Device Bridge
Documentation=https://github.com/yourusername/titanshare-daemon
After=network-online.target graphical-session.target
Wants=network-online.target

[Service]
Type=notify
# Create received_files subdir if it doesn't exist (fallback for StateDirectory)
ExecStartPre=/usr/bin/mkdir -p /var/lib/titanshare/received_files
ExecStart=/usr/local/bin/titanshare-daemon
Restart=on-failure
RestartSec=3
NotifyAccess=main

# Run as current user (not root by default)
# Override with: systemctl edit titanshare
# User=msfvenom

# Environment for PulseAudio / PipeWire access
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PULSE_RUNTIME_PATH=/run/user/1000/pulse
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus

# Needs access to uinput for virtual input
SupplementaryGroups=input

# Data directory — systemd auto-creates /var/lib/titanshare on start
# Sub-directories are handled by tmpfiles.d/titanshare.conf and ExecStartPre
StateDirectory=titanshare
StateDirectoryMode=0755
RuntimeDirectory=titanshare

# Security hardening
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/titanshare
NoNewPrivileges=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
